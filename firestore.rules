rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() {
      return userExists() && userDoc().isActive == true;
    }
    // Retain the existing application-level role helper for non-office
    // workflows; office authorization is always checked separately below.
    function isAdmin() {
      return isActiveUser() && userDoc().role in ['admin', 'it_manager'];
    }
    function isSuperAdmin() {
      return isActiveUser() && userDoc().role == 'admin';
    }
    function assignedOfficeIds() {
      return userDoc().get('officeIds', []);
    }
    function officeIsActive(officeId) {
      return officeId is string &&
        exists(/databases/$(database)/documents/offices/$(officeId)) &&
        get(/databases/$(database)/documents/offices/$(officeId)).data.isActive == true;
    }
    function hasOfficeAccess(officeId) {
      return isSuperAdmin() ||
        (isActiveUser() &&
         userDoc().role == 'it_manager' &&
         officeIsActive(officeId) &&
         assignedOfficeIds() is list &&
         assignedOfficeIds().hasAny([officeId]));
    }
    function canReadAsset(data) {
      return isSuperAdmin() ||
        (data.keys().hasAny(['officeId']) &&
         data.officeId is string &&
         hasOfficeAccess(data.officeId));
    }
    function canWriteAsset(data) {
      // Even a global administrator must place new/updated assets in a real,
      // active office. Admins can still move legacy assets into such an office.
      return data.keys().hasAny(['officeId']) &&
        data.officeId is string &&
        officeIsActive(data.officeId) &&
        hasOfficeAccess(data.officeId);
    }
    function canAccessAssetId(assetId) {
      return assetId is string &&
        exists(/databases/$(database)/documents/assets/$(assetId)) &&
        canReadAsset(get(/databases/$(database)/documents/assets/$(assetId)).data);
    }
    function validOfficeIdAt(ids, index) {
      return ids.size() <= index ||
        (ids[index] is string &&
         ids[index].size() > 0 &&
         ids[index].size() <= 128);
    }
    function validOfficeIds(ids) {
      return ids is list &&
        ids.size() <= 20 &&
        validOfficeIdAt(ids, 0) &&
        validOfficeIdAt(ids, 1) &&
        validOfficeIdAt(ids, 2) &&
        validOfficeIdAt(ids, 3) &&
        validOfficeIdAt(ids, 4) &&
        validOfficeIdAt(ids, 5) &&
        validOfficeIdAt(ids, 6) &&
        validOfficeIdAt(ids, 7) &&
        validOfficeIdAt(ids, 8) &&
        validOfficeIdAt(ids, 9) &&
        validOfficeIdAt(ids, 10) &&
        validOfficeIdAt(ids, 11) &&
        validOfficeIdAt(ids, 12) &&
        validOfficeIdAt(ids, 13) &&
        validOfficeIdAt(ids, 14) &&
        validOfficeIdAt(ids, 15) &&
        validOfficeIdAt(ids, 16) &&
        validOfficeIdAt(ids, 17) &&
        validOfficeIdAt(ids, 18) &&
        validOfficeIdAt(ids, 19);
    }
    function validOfficeAssignment(data) {
      return data.keys().hasAny(['officeIds']) &&
        validOfficeIds(data.officeIds) &&
        ((data.role == 'admin' && data.officeIds.size() == 0) ||
         (data.role == 'it_manager' && data.officeIds.size() >= 1));
    }

    function custodyUpdateAllowed() {
      let approvalBefore = resource.data.get('approvalStatus', 'approved');
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let assetId = resource.data.assetId;
      let assetAfter = getAfter(/databases/$(database)/documents/assets/$(assetId)).data;
      let assetPath = /databases/$(database)/documents/assets/$(resource.data.assetId);
      return isAdmin() &&
        resource.data.get('officeId', null) is string &&
        hasOfficeAccess(resource.data.officeId) &&
        exists(assetPath) &&
        get(assetPath).data.officeId == resource.data.officeId &&
        canAccessAssetId(resource.data.assetId) && (
        (
          approvalBefore == 'pending' &&
          resource.data.status == 'active' &&
          request.resource.data.approvalStatus == 'approved' &&
          request.resource.data.approvedBy == request.auth.uid &&
          request.resource.data.approvedAt is timestamp &&
          changed.hasOnly(['approvalStatus', 'approvedBy', 'approvedAt']) &&
          assetAfter.status == 'assigned'
        ) ||
        (
          approvalBefore == 'pending' &&
          resource.data.status == 'active' &&
          request.resource.data.approvalStatus == 'rejected' &&
          request.resource.data.status == 'rejected' &&
          request.resource.data.rejectedBy == request.auth.uid &&
          request.resource.data.rejectedAt is string &&
          request.resource.data.rejectedAt.size() > 0 &&
          request.resource.data.rejectionReason is string &&
          changed.hasOnly(['approvalStatus', 'status', 'rejectedBy', 'rejectedAt', 'rejectionReason']) &&
          assetAfter.status == 'available'
        ) ||
        (
          approvalBefore == 'approved' &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'returned' &&
          request.resource.data.returnedAt is string &&
          request.resource.data.returnedAt.size() > 0 &&
          changed.hasOnly(['status', 'returnedAt']) &&
          assetAfter.status == 'available'
        ) ||
        (
          approvalBefore == 'approved' &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'active' &&
          request.resource.data.employeeName is string &&
          request.resource.data.employeeName.size() > 0 &&
          request.resource.data.officeName is string &&
          request.resource.data.officeName.size() > 0 &&
          request.resource.data.transferredAt is string &&
          request.resource.data.transferredAt.size() > 0 &&
          changed.hasOnly(['employeeName', 'officeName', 'transferredAt']) &&
          assetAfter.officeName == request.resource.data.officeName
        )
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin() && request.auth.uid != uid &&
        request.resource.data.keys().hasOnly([
          'displayName', 'email', 'role', 'isActive', 'officeIds',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'displayName', 'email', 'role', 'isActive', 'officeIds', 'createdAt'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.role in ['admin', 'it_manager'] &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdAt is timestamp &&
        validOfficeAssignment(request.resource.data) &&
        (!request.resource.data.keys().hasAny(['updatedAt']) ||
          request.resource.data.updatedAt is timestamp);
      allow update: if (
          isSuperAdmin() && request.auth.uid != uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'role', 'isActive', 'officeIds', 'updatedAt']) &&
          request.resource.data.role in ['admin', 'it_manager'] &&
          request.resource.data.isActive is bool &&
          request.resource.data.displayName is string &&
          request.resource.data.email is string &&
          validOfficeAssignment(request.resource.data) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
            request.resource.data.updatedAt is timestamp)
        ) || (
          isActiveUser() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'updatedAt']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
            request.resource.data.displayName is string) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
            request.resource.data.email is string) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
            request.resource.data.updatedAt is timestamp)
        );
      allow delete: if false;
    }

    function validOffice(data, officeId) {
      return data.keys().hasOnly([
          'id', 'name', 'building', 'directorate', 'department',
          'room', 'manager', 'phone', 'notes', 'isActive'
        ]) &&
        data.keys().hasAll(['id', 'name', 'isActive']) &&
        data.id == officeId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.isActive is bool &&
        (!data.keys().hasAny(['building']) || data.building is string) &&
        (!data.keys().hasAny(['directorate']) || data.directorate is string) &&
        (!data.keys().hasAny(['department']) || data.department is string) &&
        (!data.keys().hasAny(['room']) || data.room is string) &&
        (!data.keys().hasAny(['manager']) || data.manager is string) &&
        (!data.keys().hasAny(['phone']) || data.phone is string) &&
        (!data.keys().hasAny(['notes']) || data.notes is string);
    }

    match /offices/{officeId} {
      // A manager can see only offices explicitly assigned by a super admin.
      allow read: if hasOfficeAccess(officeId);
      // Office catalogue and lifecycle are centrally administered.
      allow create, update: if isSuperAdmin() &&
        validOffice(request.resource.data, officeId);
      allow delete: if false;
    }

    match /assets/{assetId} {
      // Documents with no officeId are legacy/unassigned and admin-only.
      allow read: if (resource == null && isActiveUser()) || canReadAsset(resource.data);
      allow create: if canWriteAsset(request.resource.data);
      // Updates must be authorized at both ends; this enforces source and
      // destination access for cross-office transfers.
      allow update: if (isSuperAdmin() && canWriteAsset(request.resource.data)) ||
        (canWriteAsset(resource.data) && canWriteAsset(request.resource.data));
      allow delete: if false;
    }

    match /asset_serials/{serialId} {
      allow read: if (resource == null && isActiveUser()) || isSuperAdmin() ||
        (resource.data.keys().hasAny(['officeId']) &&
         hasOfficeAccess(resource.data.officeId));
      allow create: if canWriteAsset(request.resource.data);
      allow update: if canWriteAsset(resource.data) &&
        canWriteAsset(request.resource.data);
      allow delete: if isSuperAdmin() ||
        (resource.data.keys().hasAny(['officeId']) &&
         hasOfficeAccess(resource.data.officeId));
    }

    function validMovement(data) {
      let assetPath = /databases/$(database)/documents/assets/$(data.assetId);
      let officeBefore = get(assetPath).data.officeId;
      let officeAfter = getAfter(assetPath).data.officeId;
      return data.assetId is string &&
        data.officeId is string &&
        exists(assetPath) &&
        canAccessAssetId(data.assetId) &&
        data.officeId == officeAfter &&
        (!data.keys().hasAny(['fromOfficeId']) ||
          data.fromOfficeId == officeBefore) &&
        (!data.keys().hasAny(['toOfficeId']) ||
          data.toOfficeId == officeAfter);
    }
    match /asset_movements/{movementId} {
      allow read: if isSuperAdmin() ||
        (resource.data.keys().hasAny(['officeId']) &&
         hasOfficeAccess(resource.data.officeId));
      allow create: if validMovement(request.resource.data) &&
        (isSuperAdmin() ||
         (hasOfficeAccess(request.resource.data.officeId) &&
          (!request.resource.data.keys().hasAny(['fromOfficeId']) ||
            hasOfficeAccess(request.resource.data.fromOfficeId)) &&
          (!request.resource.data.keys().hasAny(['toOfficeId']) ||
            hasOfficeAccess(request.resource.data.toOfficeId))));
      allow update, delete: if false;
    }

    match /custody_cards/{cardId} {
      // Legacy custody cards without officeId remain administrator-only.
      allow read: if isSuperAdmin() ||
        (resource.data.get('officeId', null) is string &&
         hasOfficeAccess(resource.data.officeId));
      allow create: if isAdmin() &&
        request.resource.data.assetId is string &&
        request.resource.data.officeId is string &&
        canAccessAssetId(request.resource.data.assetId) &&
        get(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.officeId ==
          request.resource.data.officeId &&
        request.resource.data.status == 'active' &&
        request.resource.data.approvalStatus == 'pending' &&
        getAfter(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.status == 'assigned' &&
        getAfter(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.officeName ==
          request.resource.data.officeName;
      allow update: if custodyUpdateAllowed() &&
        request.resource.data.officeId == resource.data.officeId;
      allow delete: if false;
    }

    function validPurchaseAttachment(data) {
      let purchaseId = data.get('purchaseRecordId', null);
      return purchaseId == null ||
        (purchaseId is string &&
         exists(/databases/$(database)/documents/purchase_records/$(purchaseId)) &&
         get(/databases/$(database)/documents/purchase_records/$(purchaseId)).data.assetId == data.assetId &&
         get(/databases/$(database)/documents/purchase_records/$(purchaseId)).data.officeId == data.officeId);
    }

    match /asset_documents/{documentId} {
      // Metadata must match its linked asset and, when supplied, its purchase
      // record. The client-provided officeId is never an authorization boundary.
      allow read: if isSuperAdmin() ||
        (resource.data.assetId is string &&
         resource.data.officeId is string &&
         canAccessAssetId(resource.data.assetId) &&
         get(/databases/$(database)/documents/assets/$(resource.data.assetId)).data.officeId ==
           resource.data.officeId &&
         validPurchaseAttachment(resource.data));
      allow create: if request.resource.data.assetId is string &&
        request.resource.data.officeId is string &&
        validPurchaseAttachment(request.resource.data) &&
        ((isSuperAdmin() &&
          canAccessAssetId(request.resource.data.assetId) &&
          get(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.officeId ==
            request.resource.data.officeId) ||
         (isAdmin() &&
          hasOfficeAccess(request.resource.data.officeId) &&
          canAccessAssetId(request.resource.data.assetId) &&
          get(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.officeId ==
            request.resource.data.officeId));
      allow update, delete: if false;
    }

    function linkedAssetOffice(assetId, officeId) {
      return assetId is string && officeId is string &&
        exists(/databases/$(database)/documents/assets/$(assetId)) &&
        get(/databases/$(database)/documents/assets/$(assetId)).data.officeId == officeId &&
        canAccessAssetId(assetId);
    }
    function allocationLineQuantity(lines, index) {
      return lines.size() > index ? lines[index].quantity : 0;
    }
    function allocationLineCost(lines, index) {
      return lines.size() > index && lines[index].totalCost is number
        ? lines[index].totalCost : 0;
    }
    function allocationLineLegacyQuantity(lines, index) {
      return lines.size() > index && lines[index].sourceType == 'legacy_untracked'
        ? lines[index].quantity : 0;
    }
    function validAllocationLine(lines, index, usageId, usage) {
      return lines.size() <= index ||
        validAllocationLineValue(lines[index], usageId, usage);
    }
    function validAllocationLineValue(line, usageId, usage) {
      return line is map && validAllocationLineMap(line, usageId, usage);
    }
    function validAllocationLineMap(line, usageId, usage) {
      return line.keys().hasOnly([
           'sourceType', 'lotId', 'receiptId', 'supplier',
           'quantity', 'unitCost', 'totalCost'
         ]) &&
         line.keys().hasAll([
           'sourceType', 'lotId', 'receiptId', 'supplier',
           'quantity', 'unitCost', 'totalCost'
         ]) &&
         line.quantity is int && line.quantity > 0 &&
         ((line.sourceType == 'legacy_untracked' &&
           line.lotId == null && line.receiptId == null &&
           line.supplier == null && line.unitCost == null &&
           line.totalCost == null) ||
          (line.sourceType == 'lot' &&
           validLotAllocationLine(line, usageId, usage)));
    }
    function validLotAllocationLine(line, usageId, usage) {
      let lotPath = /databases/$(database)/documents/spare_part_lots/$(line.lotId);
      let balancePath = /databases/$(database)/documents/spare_part_lot_balances/$(line.lotId);
      return line.lotId is string && line.receiptId is string &&
        line.supplier is string && line.unitCost is number &&
        line.unitCost >= 0 && line.totalCost is number &&
        line.totalCost == line.quantity * line.unitCost &&
        exists(lotPath) && exists(balancePath) &&
        get(lotPath).data.partId == usage.partId &&
        get(lotPath).data.officeId == usage.officeId &&
        get(lotPath).data.receiptId == line.receiptId &&
        get(lotPath).data.supplier == line.supplier &&
        get(lotPath).data.unitCost == line.unitCost &&
        get(balancePath).data.remainingQuantity >= line.quantity &&
        getAfter(balancePath).data.remainingQuantity ==
          get(balancePath).data.remainingQuantity - line.quantity &&
        getAfter(balancePath).data.lastAllocationId == usageId &&
        getAfter(balancePath).data.diff(get(balancePath).data)
          .affectedKeys().hasOnly([
            'remainingQuantity', 'updatedAt', 'lastAllocationId'
          ]) &&
        getAfter(balancePath).data.updatedAt is timestamp;
    }
    function validAllocationLines(lines, usageId, usage) {
      return lines is list && lines.size() >= 1 && lines.size() <= 5 &&
        allocationLineQuantity(lines, 0) +
          allocationLineQuantity(lines, 1) +
          allocationLineQuantity(lines, 2) +
          allocationLineQuantity(lines, 3) +
          allocationLineQuantity(lines, 4) == usage.quantity &&
        allocationLineCost(lines, 0) +
          allocationLineCost(lines, 1) +
          allocationLineCost(lines, 2) +
          allocationLineCost(lines, 3) +
          allocationLineCost(lines, 4) == usage.totalCost &&
        allocationLineLegacyQuantity(lines, 0) +
          allocationLineLegacyQuantity(lines, 1) +
          allocationLineLegacyQuantity(lines, 2) +
          allocationLineLegacyQuantity(lines, 3) +
          allocationLineLegacyQuantity(lines, 4) == usage.legacyQuantity &&
        validAllocationLine(lines, 0, usageId, usage) &&
        validAllocationLine(lines, 1, usageId, usage) &&
        validAllocationLine(lines, 2, usageId, usage) &&
        validAllocationLine(lines, 3, usageId, usage) &&
        validAllocationLine(lines, 4, usageId, usage);
    }
    function validAllocationBatch(usageId, usage) {
      let allocationPath = /databases/$(database)/documents/spare_part_allocations/$(usageId);
      let allocation = getAfter(allocationPath).data;
      return usage.allocationId == usageId &&
        usage.allocationCount is int &&
        usage.allocationCount >= 1 && usage.allocationCount <= 5 &&
        usage.legacyQuantity is int &&
        usage.legacyQuantity >= 0 && usage.legacyQuantity <= usage.quantity &&
        usage.costAttributionComplete == (usage.legacyQuantity == 0) &&
        existsAfter(allocationPath) &&
        allocation.keys().hasOnly([
          'usageId', 'partId', 'officeId', 'maintenanceId', 'assetId',
          'quantity', 'totalCost', 'lines', 'createdAt', 'createdBy'
        ]) &&
        allocation.keys().hasAll([
          'usageId', 'partId', 'officeId', 'maintenanceId', 'assetId',
          'quantity', 'totalCost', 'lines', 'createdAt', 'createdBy'
        ]) &&
        allocation.usageId == usageId &&
        allocation.partId == usage.partId &&
        allocation.officeId == usage.officeId &&
        allocation.maintenanceId == usage.maintenanceId &&
        allocation.assetId == usage.assetId &&
        allocation.quantity == usage.quantity &&
        allocation.totalCost == usage.totalCost &&
        allocation.lines.size() == usage.allocationCount &&
        allocation.createdBy == request.auth.uid &&
        allocation.createdAt is timestamp &&
        validAllocationLines(allocation.lines, usageId, usage);
    }
    function validPartsUsageLink(usageId, usage) {
      let partPath = /databases/$(database)/documents/spare_parts/$(usage.partId);
      let ticketPath = /databases/$(database)/documents/maintenance_records/$(usage.maintenanceId);
      let assetPath = /databases/$(database)/documents/assets/$(usage.assetId);
      return usageId is string && usageId.size() > 0 &&
        usage.partId is string && usage.partName is string &&
        usage.maintenanceId is string && usage.assetId is string &&
        usage.officeId is string &&
        usage.quantity is int && usage.quantity > 0 &&
        usage.unitCost is number && usage.unitCost >= 0 &&
        usage.totalCost is number && usage.totalCost >= 0 &&
        usage.notes is string && usage.usedAt is timestamp &&
        usage.createdBy == request.auth.uid &&
        exists(assetPath) &&
        get(assetPath).data.officeId == usage.officeId &&
        get(assetPath).data.status == 'maintenance' &&
        hasOfficeAccess(usage.officeId);
    }

    function validSparePartRestock(partId) {
      let restockId = request.resource.data.get('lastRestockId', null);
      let receiptPath = /databases/$(database)/documents/spare_part_receipts/$(restockId);
      let lotPath = /databases/$(database)/documents/spare_part_lots/$(restockId);
      let balancePath = /databases/$(database)/documents/spare_part_lot_balances/$(restockId);
      let receipt = getAfter(receiptPath).data;
      let lot = getAfter(lotPath).data;
      let oldUntracked = resource.data.get('untrackedQuantity', resource.data.quantity);
      return restockId is string && existsAfter(receiptPath) &&
        existsAfter(lotPath) && existsAfter(balancePath) &&
        request.resource.data.officeId == resource.data.officeId &&
        receipt.keys().hasAll([
          'partId', 'officeId', 'lotId', 'quantity', 'quantityBefore', 'quantityAfter',
          'unitCost', 'totalCost', 'supplier', 'notes', 'receivedAt',
          'createdAt', 'createdBy'
        ]) &&
        receipt.partId == partId &&
        receipt.officeId == resource.data.officeId &&
        receipt.lotId == restockId &&
        receipt.createdBy == request.auth.uid &&
        receipt.quantity is int && receipt.quantity > 0 &&
        receipt.quantityBefore == resource.data.quantity &&
        receipt.quantityAfter == request.resource.data.quantity &&
        request.resource.data.quantity == resource.data.quantity + receipt.quantity &&
        request.resource.data.untrackedQuantity == oldUntracked &&
        receipt.unitCost is number && receipt.unitCost >= 0 &&
        receipt.totalCost == receipt.quantity * receipt.unitCost &&
        request.resource.data.unitCost == receipt.unitCost &&
        request.resource.data.supplier == receipt.supplier &&
        receipt.supplier is string && receipt.supplier.size() > 0 &&
        receipt.notes is string &&
        receipt.receivedAt is timestamp && receipt.createdAt is timestamp &&
        lot.partId == partId && lot.officeId == resource.data.officeId &&
        lot.receiptId == restockId && lot.supplier == receipt.supplier &&
        lot.receivedQuantity == receipt.quantity &&
        lot.unitCost == receipt.unitCost && lot.totalCost == receipt.totalCost &&
        lot.receivedAt == receipt.receivedAt && lot.createdBy == request.auth.uid &&
        getAfter(balancePath).data.lotId == restockId &&
        getAfter(balancePath).data.partId == partId &&
        getAfter(balancePath).data.officeId == resource.data.officeId &&
        getAfter(balancePath).data.remainingQuantity == receipt.quantity &&
        request.resource.data.lastRestockId == restockId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'quantity', 'untrackedQuantity', 'unitCost', 'supplier',
            'lastRestockId', 'updatedAt'
          ]) &&
        request.resource.data.updatedAt is timestamp &&
        hasOfficeAccess(resource.data.officeId);
    }

    function validSparePartReceiptCreate(receiptId, data) {
      let partPath = /databases/$(database)/documents/spare_parts/$(data.partId);
      let lotPath = /databases/$(database)/documents/spare_part_lots/$(receiptId);
      let balancePath = /databases/$(database)/documents/spare_part_lot_balances/$(receiptId);
      let partAfter = getAfter(partPath).data;
      let lotAfter = getAfter(lotPath).data;
      let balanceAfter = getAfter(balancePath).data;
      return isActiveUser() && data.keys().hasOnly([
          'partId', 'officeId', 'lotId', 'quantity', 'quantityBefore', 'quantityAfter',
          'unitCost', 'totalCost', 'supplier', 'notes', 'receivedAt',
          'createdAt', 'createdBy'
        ]) &&
        data.keys().hasAll([
          'partId', 'officeId', 'lotId', 'quantity', 'quantityBefore', 'quantityAfter',
          'unitCost', 'totalCost', 'supplier', 'notes', 'receivedAt',
          'createdAt', 'createdBy'
        ]) &&
        data.partId is string && data.officeId is string &&
        data.lotId == receiptId &&
        data.quantity is int && data.quantity > 0 &&
        data.quantityBefore is int && data.quantityBefore >= 0 &&
        data.quantityAfter is int &&
        data.quantityAfter == data.quantityBefore + data.quantity &&
        data.unitCost is number && data.unitCost >= 0 &&
        data.totalCost is number && data.totalCost == data.quantity * data.unitCost &&
        data.supplier is string && data.supplier.size() > 0 &&
        data.notes is string &&
        data.receivedAt is timestamp && data.createdAt is timestamp &&
        data.createdBy == request.auth.uid &&
        hasOfficeAccess(data.officeId) &&
        existsAfter(partPath) && existsAfter(lotPath) && existsAfter(balancePath) &&
        partAfter.officeId == data.officeId &&
        partAfter.quantity == data.quantityAfter &&
        partAfter.lastRestockId == receiptId &&
        lotAfter.partId == data.partId && lotAfter.officeId == data.officeId &&
        lotAfter.receiptId == receiptId &&
        lotAfter.receivedQuantity == data.quantity &&
        lotAfter.unitCost == data.unitCost && lotAfter.totalCost == data.totalCost &&
        lotAfter.supplier == data.supplier &&
        balanceAfter.lotId == receiptId && balanceAfter.partId == data.partId &&
        balanceAfter.officeId == data.officeId &&
        balanceAfter.remainingQuantity == data.quantity;
    }

    function validSparePart(data, officeId) {
      return data.keys().hasOnly([
          'officeId', 'name', 'sku', 'quantity', 'untrackedQuantity',
          'minimumQuantity', 'unitCost', 'supplier', 'createdAt',
          'updatedAt', 'lastRestockId'
        ]) &&
        data.keys().hasAll([
          'officeId', 'name', 'sku', 'quantity', 'minimumQuantity',
          'unitCost', 'supplier', 'createdAt', 'updatedAt'
        ]) &&
        data.officeId == officeId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 180 &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 80 &&
        data.quantity is int && data.quantity >= 0 &&
        (!data.keys().hasAny(['untrackedQuantity']) ||
          (data.untrackedQuantity is int &&
           data.untrackedQuantity >= 0 &&
           data.untrackedQuantity <= data.quantity)) &&
        data.minimumQuantity is int && data.minimumQuantity >= 0 &&
        data.unitCost is number && data.unitCost >= 0 &&
        data.supplier is string &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validSparePartConsumption(partId) {
      let usageId = request.resource.data.get('lastUsageId', null);
      let usagePath = /databases/$(database)/documents/maintenance_parts/$(usageId);
      let usage = getAfter(usagePath).data;
      let oldUntracked = resource.data.get('untrackedQuantity', resource.data.quantity);
      return usageId is string && existsAfter(usagePath) &&
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.quantity == resource.data.quantity - usage.quantity &&
        request.resource.data.untrackedQuantity ==
          oldUntracked - usage.legacyQuantity &&
        request.resource.data.unitCost == resource.data.unitCost &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantity', 'untrackedQuantity', 'lastUsageId', 'updatedAt']) &&
        request.resource.data.updatedAt is timestamp &&
        usage.partId == partId &&
        usage.officeId == resource.data.officeId &&
        usage.allocationId == usageId &&
        getAfter(/databases/$(database)/documents/maintenance_records/$(usage.maintenanceId)).data.lastPartsUsageId == usageId &&
        getAfter(/databases/$(database)/documents/maintenance_records/$(usage.maintenanceId)).data.officeId == resource.data.officeId &&
        validAllocationBatch(usageId, usage);
    }

    function validMaintenancePartsCostUpdate(recordId) {
      let usageId = request.resource.data.get('lastPartsUsageId', null);
      let usagePath = /databases/$(database)/documents/maintenance_parts/$(usageId);
      let usage = getAfter(usagePath).data;
      let partPath = /databases/$(database)/documents/spare_parts/$(usage.partId);
      return usageId is string && existsAfter(usagePath) &&
        request.resource.data.assetId == resource.data.assetId &&
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.status == resource.data.status &&
        resource.data.status in ['open', 'inProgress'] &&
        request.resource.data.partsCost == resource.data.get('partsCost', 0) + usage.totalCost &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['partsCost', 'lastPartsUsageId', 'updatedAt']) &&
        request.resource.data.updatedAt is timestamp &&
        usage.maintenanceId == recordId &&
        usage.assetId == resource.data.assetId &&
        usage.officeId == resource.data.officeId &&
        getAfter(partPath).data.get('lastUsageId', null) == usageId &&
        getAfter(partPath).data.officeId == resource.data.officeId;
    }

    match /maintenance_records/{recordId} {
      // officeId is the queryable tenant boundary. Creation and every
      // client update still validate the linked asset's office; records
      // without officeId remain administrator-only.
      allow read: if isSuperAdmin() ||
        (resource.data.officeId is string &&
         hasOfficeAccess(resource.data.officeId));
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['assetId', 'officeId']) &&
        linkedAssetOffice(request.resource.data.assetId, request.resource.data.officeId) &&
        request.resource.data.status == 'open';
      allow update: if resource.data.officeId is string &&
        hasOfficeAccess(resource.data.officeId) &&
        exists(/databases/$(database)/documents/assets/$(resource.data.assetId)) &&
        get(/databases/$(database)/documents/assets/$(resource.data.assetId)).data.officeId ==
          resource.data.officeId && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'resolution', 'cost', 'completedAt']) &&
            resource.data.keys().hasAll(['assetId', 'officeId', 'previousAssetStatus']) &&
            request.resource.data.assetId == resource.data.assetId &&
            request.resource.data.officeId == resource.data.officeId &&
            request.resource.data.status == 'completed' &&
            request.resource.data.resolution is string &&
            request.resource.data.resolution.size() > 0 &&
            request.resource.data.cost is number &&
            request.resource.data.cost >= 0 &&
            request.resource.data.completedAt is timestamp &&
            getAfter(/databases/$(database)/documents/assets/$(resource.data.assetId)).data.status ==
              resource.data.previousAssetStatus
          ) || validMaintenancePartsCostUpdate(recordId)
        );
      allow delete: if false;
    }
    match /purchase_records/{recordId} {
      allow read: if isSuperAdmin() ||
        (resource.data.keys().hasAll(['assetId', 'officeId']) &&
         linkedAssetOffice(resource.data.assetId, resource.data.officeId));
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['assetId', 'officeId']) &&
        linkedAssetOffice(request.resource.data.assetId, request.resource.data.officeId);
      // Purchase records are append-only from client workflows. Corrections
      // must use a separately reviewed administrative process, not client edits.
      allow update, delete: if false;
    }

    match /maintenance_parts/{usageId} {
      allow read: if isSuperAdmin() ||
        (resource.data.officeId is string && hasOfficeAccess(resource.data.officeId));
      allow create: if validPartsUsageLink(usageId, request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'partId', 'partName', 'maintenanceId', 'assetId', 'officeId',
          'quantity', 'unitCost', 'totalCost', 'notes', 'usedAt', 'createdBy',
          'allocationId', 'allocationCount', 'legacyQuantity',
          'costAttributionComplete'
        ]) &&
        request.resource.data.keys().hasAll([
          'partId', 'partName', 'maintenanceId', 'assetId', 'officeId',
          'quantity', 'unitCost', 'totalCost', 'notes', 'usedAt', 'createdBy',
          'allocationId', 'allocationCount', 'legacyQuantity',
          'costAttributionComplete'
        ]);
      allow update, delete: if false;
    }

    function validImportBatch(data) {
      return data.keys().hasOnly([
          'sourceName', 'createdBy', 'createdAt', 'completedAt',
          'totalRows', 'attemptedRows', 'succeededRows', 'failedRows',
          'skippedInvalidRows', 'status', 'rowErrors'
        ]) &&
        data.keys().hasAll([
          'sourceName', 'createdBy', 'createdAt', 'completedAt',
          'totalRows', 'attemptedRows', 'succeededRows', 'failedRows',
          'skippedInvalidRows', 'status', 'rowErrors'
        ]) &&
        data.sourceName is string && data.sourceName.size() <= 255 &&
        data.createdBy is string && data.createdAt is timestamp &&
        data.completedAt is timestamp &&
        data.totalRows is int && data.totalRows >= 0 && data.totalRows <= 100 &&
        data.attemptedRows is int && data.attemptedRows >= 0 &&
        data.succeededRows is int && data.succeededRows >= 0 &&
        data.failedRows is int && data.failedRows >= 0 &&
        data.skippedInvalidRows is int && data.skippedInvalidRows >= 0 &&
        data.attemptedRows + data.skippedInvalidRows == data.totalRows &&
        data.succeededRows + data.failedRows == data.attemptedRows &&
        data.status in ['completed', 'partial', 'failed'] &&
        data.rowErrors is list && data.rowErrors.size() == data.failedRows &&
        data.rowErrors.size() <= 100 &&
        ((data.failedRows == 0 && data.status == 'completed') ||
          (data.failedRows > 0 && data.succeededRows > 0 && data.status == 'partial') ||
          (data.failedRows > 0 && data.succeededRows == 0 && data.status == 'failed'));
    }

    match /import_batches/{batchId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.createdBy == request.auth.uid &&
        validImportBatch(request.resource.data);
      allow update, delete: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    function validSparePartLotCreate(lotId, data) {
      let receiptPath = /databases/$(database)/documents/spare_part_receipts/$(lotId);
      let partPath = /databases/$(database)/documents/spare_parts/$(data.partId);
      return isActiveUser() && data.keys().hasOnly([
          'partId', 'officeId', 'receiptId', 'supplier', 'receivedQuantity',
          'unitCost', 'totalCost', 'receivedAt', 'createdAt', 'createdBy'
        ]) &&
        data.keys().hasAll([
          'partId', 'officeId', 'receiptId', 'supplier', 'receivedQuantity',
          'unitCost', 'totalCost', 'receivedAt', 'createdAt', 'createdBy'
        ]) &&
        data.receiptId == lotId &&
        data.partId is string && data.officeId is string &&
        data.supplier is string && data.supplier.size() > 0 &&
        data.receivedQuantity is int && data.receivedQuantity > 0 &&
        data.unitCost is number && data.unitCost >= 0 &&
        data.totalCost == data.receivedQuantity * data.unitCost &&
        data.receivedAt is timestamp && data.createdAt is timestamp &&
        data.createdBy == request.auth.uid &&
        hasOfficeAccess(data.officeId) &&
        existsAfter(receiptPath) && existsAfter(partPath) &&
        getAfter(receiptPath).data.lotId == lotId &&
        getAfter(receiptPath).data.partId == data.partId &&
        getAfter(receiptPath).data.officeId == data.officeId &&
        getAfter(partPath).data.officeId == data.officeId;
    }
    function validSparePartLotBalanceCreate(lotId, data) {
      let lotPath = /databases/$(database)/documents/spare_part_lots/$(lotId);
      return isActiveUser() && data.keys().hasOnly([
          'lotId', 'partId', 'officeId', 'remainingQuantity',
          'createdAt', 'updatedAt', 'lastAllocationId'
        ]) &&
        data.keys().hasAll([
          'lotId', 'partId', 'officeId', 'remainingQuantity',
          'createdAt', 'updatedAt', 'lastAllocationId'
        ]) &&
        data.lotId == lotId && data.partId is string &&
        data.officeId is string &&
        data.remainingQuantity is int && data.remainingQuantity > 0 &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        data.lastAllocationId == null &&
        existsAfter(lotPath) &&
        getAfter(lotPath).data.partId == data.partId &&
        getAfter(lotPath).data.officeId == data.officeId &&
        getAfter(lotPath).data.receivedQuantity == data.remainingQuantity &&
        hasOfficeAccess(data.officeId);
    }
    function allocationContainsLotLine(lines, index, lotId, quantity) {
      return lines.size() > index &&
        lines[index].sourceType == 'lot' &&
        lines[index].lotId == lotId &&
        lines[index].quantity == quantity;
    }
    function validSparePartLotBalanceUpdate(lotId) {
      let allocationId = request.resource.data.get('lastAllocationId', null);
      let allocationPath = /databases/$(database)/documents/spare_part_allocations/$(allocationId);
      let allocation = getAfter(allocationPath).data;
      let issuedQuantity = resource.data.remainingQuantity -
        request.resource.data.remainingQuantity;
      return allocationId is string &&
        allocationId != resource.data.get('lastAllocationId', null) &&
        existsAfter(allocationPath) &&
        request.resource.data.lotId == resource.data.lotId &&
        request.resource.data.partId == resource.data.partId &&
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.remainingQuantity is int &&
        request.resource.data.remainingQuantity >= 0 &&
        request.resource.data.remainingQuantity < resource.data.remainingQuantity &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['remainingQuantity', 'updatedAt', 'lastAllocationId']) &&
        allocation.usageId == allocationId &&
        allocation.partId == resource.data.partId &&
        allocation.officeId == resource.data.officeId &&
        (allocationContainsLotLine(allocation.lines, 0, lotId, issuedQuantity) ||
         allocationContainsLotLine(allocation.lines, 1, lotId, issuedQuantity) ||
         allocationContainsLotLine(allocation.lines, 2, lotId, issuedQuantity) ||
         allocationContainsLotLine(allocation.lines, 3, lotId, issuedQuantity) ||
         allocationContainsLotLine(allocation.lines, 4, lotId, issuedQuantity));
    }
    function validSparePartAllocationCreate(allocationId, data) {
      let usagePath = /databases/$(database)/documents/maintenance_parts/$(allocationId);
      return isActiveUser() && data.keys().hasOnly([
          'usageId', 'partId', 'officeId', 'maintenanceId', 'assetId',
          'quantity', 'totalCost', 'lines', 'createdAt', 'createdBy'
        ]) &&
        data.keys().hasAll([
          'usageId', 'partId', 'officeId', 'maintenanceId', 'assetId',
          'quantity', 'totalCost', 'lines', 'createdAt', 'createdBy'
        ]) &&
        data.usageId == allocationId &&
        existsAfter(usagePath) &&
        getAfter(usagePath).data.allocationId == allocationId &&
        getAfter(usagePath).data.partId == data.partId &&
        getAfter(usagePath).data.officeId == data.officeId &&
        getAfter(usagePath).data.maintenanceId == data.maintenanceId &&
        getAfter(usagePath).data.assetId == data.assetId &&
        getAfter(usagePath).data.quantity == data.quantity &&
        getAfter(usagePath).data.totalCost == data.totalCost &&
        getAfter(usagePath).data.createdBy == data.createdBy &&
        data.createdBy == request.auth.uid;
    }

    match /spare_parts/{partId} {
      // Office stock is isolated; legacy stock without officeId remains
      // visible to the global administrator only and cannot be consumed.
      allow read: if canReadAsset(resource.data);
      allow create: if canWriteAsset(request.resource.data) &&
        validSparePart(request.resource.data, request.resource.data.officeId);
      // Stock changes only through a validated atomic usage or receipt.
      allow update: if canWriteAsset(resource.data) && (
        (request.resource.data.keys().hasAny(['lastUsageId']) &&
          validSparePartConsumption(partId)) ||
        (request.resource.data.keys().hasAny(['lastRestockId']) &&
          validSparePartRestock(partId))
      );
      allow delete: if false;
    }

    match /spare_part_receipts/{receiptId} {
      allow read: if canReadAsset(resource.data);
      allow create: if validSparePartReceiptCreate(receiptId, request.resource.data);
      allow update, delete: if false;
    }
    match /spare_part_lots/{lotId} {
      allow read: if canReadAsset(resource.data);
      allow create: if validSparePartLotCreate(lotId, request.resource.data);
      allow update, delete: if false;
    }
    match /spare_part_lot_balances/{lotId} {
      allow read: if canReadAsset(resource.data);
      allow create: if validSparePartLotBalanceCreate(lotId, request.resource.data);
      allow update: if validSparePartLotBalanceUpdate(lotId);
      allow delete: if false;
    }
    match /spare_part_allocations/{allocationId} {
      allow read: if canReadAsset(resource.data);
      allow create: if validSparePartAllocationCreate(allocationId, request.resource.data);
      allow update, delete: if false;
    }

    // Only non-sensitive shared lookup catalogues remain on the generic
    // path. Office-bearing and transactional collections are intentionally
    // excluded until their own asset-to-office linkage is secured.
    match /{collection}/{document=**} {
      allow read: if isActiveUser() &&
        collection in ['asset_categories', 'asset_models'];
      allow create, update: if isAdmin() &&
        collection in ['asset_categories', 'asset_models'];
      allow delete: if false;
    }
  }
}
