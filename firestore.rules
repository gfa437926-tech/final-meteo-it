rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() {
      return userExists() && userDoc().isActive == true;
    }
    // Retain the existing application-level role helper for non-office
    // workflows; office authorization is always checked separately below.
    function isAdmin() {
      return isActiveUser() && userDoc().role in ['admin', 'it_manager'];
    }
    function isSuperAdmin() {
      return isActiveUser() && userDoc().role == 'admin';
    }
    function assignedOfficeIds() {
      return userDoc().get('officeIds', []);
    }
    function hasOfficeAccess(officeId) {
      return isSuperAdmin() ||
        (isActiveUser() &&
         userDoc().role == 'it_manager' &&
         officeId is string &&
         assignedOfficeIds() is list &&
         assignedOfficeIds().hasAny([officeId]));
    }
    function canReadAsset(data) {
      return isSuperAdmin() ||
        (data.keys().hasAny(['officeId']) &&
         data.officeId is string &&
         hasOfficeAccess(data.officeId));
    }
    function canWriteAsset(data) {
      return isSuperAdmin() ||
        (data.keys().hasAny(['officeId']) &&
         data.officeId is string &&
         hasOfficeAccess(data.officeId) &&
         exists(/databases/$(database)/documents/offices/$(data.officeId)) &&
         get(/databases/$(database)/documents/offices/$(data.officeId)).data.isActive == true);
    }
    function canAccessAssetId(assetId) {
      return assetId is string &&
        exists(/databases/$(database)/documents/assets/$(assetId)) &&
        canReadAsset(get(/databases/$(database)/documents/assets/$(assetId)).data);
    }
    function validOfficeIdAt(ids, index) {
      return ids.size() <= index ||
        (ids[index] is string &&
         ids[index].size() > 0 &&
         ids[index].size() <= 128);
    }
    function validOfficeIds(ids) {
      return ids is list &&
        ids.size() <= 20 &&
        validOfficeIdAt(ids, 0) &&
        validOfficeIdAt(ids, 1) &&
        validOfficeIdAt(ids, 2) &&
        validOfficeIdAt(ids, 3) &&
        validOfficeIdAt(ids, 4) &&
        validOfficeIdAt(ids, 5) &&
        validOfficeIdAt(ids, 6) &&
        validOfficeIdAt(ids, 7) &&
        validOfficeIdAt(ids, 8) &&
        validOfficeIdAt(ids, 9) &&
        validOfficeIdAt(ids, 10) &&
        validOfficeIdAt(ids, 11) &&
        validOfficeIdAt(ids, 12) &&
        validOfficeIdAt(ids, 13) &&
        validOfficeIdAt(ids, 14) &&
        validOfficeIdAt(ids, 15) &&
        validOfficeIdAt(ids, 16) &&
        validOfficeIdAt(ids, 17) &&
        validOfficeIdAt(ids, 18) &&
        validOfficeIdAt(ids, 19);
    }
    function validOfficeAssignment(data) {
      return data.keys().hasAny(['officeIds']) &&
        validOfficeIds(data.officeIds) &&
        ((data.role == 'admin' && data.officeIds.size() == 0) ||
         (data.role == 'it_manager' && data.officeIds.size() >= 1));
    }

    function custodyUpdateAllowed() {
      let approvalBefore = resource.data.get('approvalStatus', 'approved');
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let assetId = resource.data.assetId;
      let assetAfter = getAfter(/databases/$(database)/documents/assets/$(assetId)).data;
      return isAdmin() && canAccessAssetId(resource.data.assetId) && (
        (
          approvalBefore == 'pending' &&
          resource.data.status == 'active' &&
          request.resource.data.approvalStatus == 'approved' &&
          request.resource.data.approvedBy == request.auth.uid &&
          request.resource.data.approvedAt is timestamp &&
          changed.hasOnly(['approvalStatus', 'approvedBy', 'approvedAt']) &&
          assetAfter.status == 'assigned'
        ) ||
        (
          approvalBefore == 'pending' &&
          resource.data.status == 'active' &&
          request.resource.data.approvalStatus == 'rejected' &&
          request.resource.data.status == 'rejected' &&
          request.resource.data.rejectedBy == request.auth.uid &&
          request.resource.data.rejectedAt is string &&
          request.resource.data.rejectedAt.size() > 0 &&
          request.resource.data.rejectionReason is string &&
          changed.hasOnly(['approvalStatus', 'status', 'rejectedBy', 'rejectedAt', 'rejectionReason']) &&
          assetAfter.status == 'available'
        ) ||
        (
          approvalBefore == 'approved' &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'returned' &&
          request.resource.data.returnedAt is string &&
          request.resource.data.returnedAt.size() > 0 &&
          changed.hasOnly(['status', 'returnedAt']) &&
          assetAfter.status == 'available'
        ) ||
        (
          approvalBefore == 'approved' &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'active' &&
          request.resource.data.employeeName is string &&
          request.resource.data.employeeName.size() > 0 &&
          request.resource.data.officeName is string &&
          request.resource.data.officeName.size() > 0 &&
          request.resource.data.transferredAt is string &&
          request.resource.data.transferredAt.size() > 0 &&
          changed.hasOnly(['employeeName', 'officeName', 'transferredAt']) &&
          assetAfter.officeName == request.resource.data.officeName
        )
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin() && request.auth.uid != uid &&
        request.resource.data.keys().hasOnly([
          'displayName', 'email', 'role', 'isActive', 'officeIds',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'displayName', 'email', 'role', 'isActive', 'officeIds', 'createdAt'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.role in ['admin', 'it_manager'] &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdAt is timestamp &&
        validOfficeAssignment(request.resource.data) &&
        (!request.resource.data.keys().hasAny(['updatedAt']) ||
          request.resource.data.updatedAt is timestamp);
      allow update: if (
          isSuperAdmin() && request.auth.uid != uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'role', 'isActive', 'officeIds', 'updatedAt']) &&
          request.resource.data.role in ['admin', 'it_manager'] &&
          request.resource.data.isActive is bool &&
          request.resource.data.displayName is string &&
          request.resource.data.email is string &&
          validOfficeAssignment(request.resource.data) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
            request.resource.data.updatedAt is timestamp)
        ) || (
          isActiveUser() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'updatedAt']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
            request.resource.data.displayName is string) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
            request.resource.data.email is string) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
            request.resource.data.updatedAt is timestamp)
        );
      allow delete: if false;
    }

    function validOffice(data, officeId) {
      return data.keys().hasOnly([
          'id', 'name', 'building', 'directorate', 'department',
          'room', 'manager', 'phone', 'notes', 'isActive'
        ]) &&
        data.keys().hasAll(['id', 'name', 'isActive']) &&
        data.id == officeId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.isActive is bool &&
        (!data.keys().hasAny(['building']) || data.building is string) &&
        (!data.keys().hasAny(['directorate']) || data.directorate is string) &&
        (!data.keys().hasAny(['department']) || data.department is string) &&
        (!data.keys().hasAny(['room']) || data.room is string) &&
        (!data.keys().hasAny(['manager']) || data.manager is string) &&
        (!data.keys().hasAny(['phone']) || data.phone is string) &&
        (!data.keys().hasAny(['notes']) || data.notes is string);
    }

    match /offices/{officeId} {
      // A manager can see only offices explicitly assigned by a super admin.
      allow read: if hasOfficeAccess(officeId);
      // Office catalogue and lifecycle are centrally administered.
      allow create, update: if isSuperAdmin() &&
        validOffice(request.resource.data, officeId);
      allow delete: if false;
    }

    match /assets/{assetId} {
      // Documents with no officeId are legacy/unassigned and admin-only.
      allow read: if (resource == null && isActiveUser()) || canReadAsset(resource.data);
      allow create: if canWriteAsset(request.resource.data);
      // Updates must be authorized at both ends; this enforces source and
      // destination access for cross-office transfers.
      allow update: if canWriteAsset(resource.data) &&
        canWriteAsset(request.resource.data);
      allow delete: if false;
    }

    match /asset_serials/{serialId} {
      allow read: if (resource == null && isActiveUser()) || isSuperAdmin() ||
        (resource.data.keys().hasAny(['officeId']) &&
         hasOfficeAccess(resource.data.officeId));
      allow create: if canWriteAsset(request.resource.data);
      allow update: if canWriteAsset(resource.data) &&
        canWriteAsset(request.resource.data);
      allow delete: if isSuperAdmin() ||
        (resource.data.keys().hasAny(['officeId']) &&
         hasOfficeAccess(resource.data.officeId));
    }

    match /asset_movements/{movementId} {
      allow read: if isSuperAdmin() ||
        (resource.data.keys().hasAny(['officeId']) &&
         hasOfficeAccess(resource.data.officeId));
      allow create: if isSuperAdmin() ||
        (request.resource.data.keys().hasAny(['officeId']) &&
         hasOfficeAccess(request.resource.data.officeId) &&
         (!request.resource.data.keys().hasAny(['fromOfficeId']) ||
           hasOfficeAccess(request.resource.data.fromOfficeId)) &&
         (!request.resource.data.keys().hasAny(['toOfficeId']) ||
           hasOfficeAccess(request.resource.data.toOfficeId)));
      allow update, delete: if false;
    }

    match /custody_cards/{cardId} {
      allow read: if canAccessAssetId(resource.data.assetId);
      allow create: if isAdmin() &&
        canAccessAssetId(request.resource.data.assetId) &&
        request.resource.data.status == 'active' &&
        request.resource.data.approvalStatus == 'pending' &&
        getAfter(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.status == 'assigned';
      allow update: if custodyUpdateAllowed();
      allow delete: if false;
    }

    match /asset_documents/{documentId} {
      allow read: if isSuperAdmin() ||
        (resource.data.officeId is string &&
         hasOfficeAccess(resource.data.officeId));
      allow create: if isSuperAdmin() ||
        (isAdmin() &&
         request.resource.data.officeId is string &&
         hasOfficeAccess(request.resource.data.officeId) &&
         canAccessAssetId(request.resource.data.assetId) &&
         get(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.officeId ==
           request.resource.data.officeId);
      allow update, delete: if false;
    }

    match /maintenance_parts/{usageId} {
      allow read: if canAccessAssetId(resource.data.assetId);
      allow create: if isAdmin() &&
        canAccessAssetId(request.resource.data.assetId);
      allow update, delete: if false;
    }

    function validImportBatch(data) {
      return data.keys().hasOnly([
          'sourceName', 'createdBy', 'createdAt', 'completedAt',
          'totalRows', 'attemptedRows', 'succeededRows', 'failedRows',
          'skippedInvalidRows', 'status', 'rowErrors'
        ]) &&
        data.keys().hasAll([
          'sourceName', 'createdBy', 'createdAt', 'completedAt',
          'totalRows', 'attemptedRows', 'succeededRows', 'failedRows',
          'skippedInvalidRows', 'status', 'rowErrors'
        ]) &&
        data.sourceName is string && data.sourceName.size() <= 255 &&
        data.createdBy is string && data.createdAt is timestamp &&
        data.completedAt is timestamp &&
        data.totalRows is int && data.totalRows >= 0 && data.totalRows <= 100 &&
        data.attemptedRows is int && data.attemptedRows >= 0 &&
        data.succeededRows is int && data.succeededRows >= 0 &&
        data.failedRows is int && data.failedRows >= 0 &&
        data.skippedInvalidRows is int && data.skippedInvalidRows >= 0 &&
        data.attemptedRows + data.skippedInvalidRows == data.totalRows &&
        data.succeededRows + data.failedRows == data.attemptedRows &&
        data.status in ['completed', 'partial', 'failed'] &&
        data.rowErrors is list && data.rowErrors.size() == data.failedRows &&
        data.rowErrors.size() <= 100 &&
        ((data.failedRows == 0 && data.status == 'completed') ||
          (data.failedRows > 0 && data.succeededRows > 0 && data.status == 'partial') ||
          (data.failedRows > 0 && data.succeededRows == 0 && data.status == 'failed'));
    }

    match /import_batches/{batchId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.createdBy == request.auth.uid &&
        validImportBatch(request.resource.data);
      allow update, delete: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /spare_parts/{partId} {
      // Office stock is isolated; legacy stock without officeId remains
      // visible to the global administrator only.
      allow read: if canReadAsset(resource.data);
      allow create: if canWriteAsset(request.resource.data);
      allow update: if canWriteAsset(resource.data) &&
        canWriteAsset(request.resource.data);
      allow delete: if false;
    }

    // Only non-sensitive shared lookup catalogues remain on the generic
    // path. Office-bearing and transactional collections are intentionally
    // excluded until their own asset-to-office linkage is secured.
    match /{collection}/{document=**} {
      allow read: if isActiveUser() &&
        collection in ['asset_categories', 'asset_models'];
      allow create, update: if isAdmin() &&
        collection in ['asset_categories', 'asset_models'];
      allow delete: if false;
    }
  }
}
