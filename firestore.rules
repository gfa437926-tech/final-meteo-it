rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() {
      return userExists() && userDoc().isActive == true;
    }
    function isAdmin() {
      return isActiveUser() && userDoc().role in ['admin', 'it_manager'];
    }
    function isSuperAdmin() {
      return isActiveUser() && userDoc().role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSuperAdmin() && request.auth.uid != uid;
      allow update: if (isSuperAdmin() && request.auth.uid != uid) ||
        (signedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'updatedAt']));
      allow delete: if false;
    }
    match /offices/{officeId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /assets/{assetId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /asset_serials/{serialId} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /custody_cards/{cardId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Spare-part stock is maintained by authorized inventory administrators.
    match /spare_parts/{partId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Usage rows are append-only evidence created in the same transaction
    // that decrements stock and accumulates the maintenance ticket's parts cost.
    match /maintenance_parts/{usageId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /{collection}/{document=**} {
      allow read: if isActiveUser() && collection in [
        'asset_categories', 'asset_models', 'custody_items',
        'asset_movements', 'asset_documents', 'maintenance_records',
        'purchase_records', 'spare_parts', 'maintenance_parts'
      ];
      allow create, update: if isAdmin() && collection in [
        'asset_categories', 'asset_models', 'custody_items',
        'asset_movements', 'asset_documents', 'maintenance_records',
        'purchase_records'
      ];
      allow delete: if false;
    }
  }
}